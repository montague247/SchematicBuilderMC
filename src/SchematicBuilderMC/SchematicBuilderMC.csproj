<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>SchematicBuilderMC</PackageId>
    <Title>SchematicBuilderMC CLI</Title>
    <Description>CLI utility for SchematicBuilderMC - convert and generate Minecraft schematics.</Description>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>schematicbuildermc</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SchematicBuilderMC.Core/SchematicBuilderMC.Core.csproj" />
  </ItemGroup>

</Project>
