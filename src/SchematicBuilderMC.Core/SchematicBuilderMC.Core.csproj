<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SchematicBuilderMC</RootNamespace>
    <PackageId>SchematicBuilderMC.Core</PackageId>
    <Title>SchematicBuilderMC.Core</Title>
    <Description>A high-performance modern .NET library for creating, manipulating, reading, and writing Minecraft schematic files (.schem, .schematic, .litematic).</Description>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="fNbt" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\registries_26_3.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SchematicBuilderMC.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
